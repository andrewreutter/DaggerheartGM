{
  "name": "daggerheart-gm",
  "version": "1.0.0",
  "description": "A GM tool for Daggerheart",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "prestart": "node --env-file=.env scripts/kill-port.mjs && npm run build",
    "start": "node --env-file=.env server.js",
    "crawl": "node --env-file=.env scripts/crawl.js",
    "crawl:fcg": "node --env-file=.env scripts/crawl.js fcg",
    "crawl:hod": "node --env-file=.env scripts/crawl.js hod",
    "refresh:daggerstack": "node scripts/refresh-daggerstack-uuids.js",
    "generate:beastforms": "node scripts/generate-beastform-srd-data.mjs",
    "generate:feature-source-paths": "node scripts/gen-feature-source-paths.mjs",
    "gen:feature-catalog": "node scripts/gen-v2-feature-catalog.mjs",
    "predev": "node --env-file=.env scripts/kill-port.mjs",
    "dev": "node --env-file=.env --watch server.js & npm run dev:css & npm run dev:js & node --env-file=.env scripts/dev-agent-queue-worker.mjs &",
    "build": "npm run gen:feature-catalog && npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "build:js": "esbuild src/client/app.jsx --bundle --format=esm --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime --external:firebase/app --external:firebase/auth --external:lucide-react --external:marked --external:highlight.js --external:@3d-dice/dice-box-threejs --outfile=public/app.js",
    "dev:js": "esbuild src/client/app.jsx --bundle --format=esm --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime --external:firebase/app --external:firebase/auth --external:lucide-react --external:marked --external:highlight.js --external:@3d-dice/dice-box-threejs --outfile=public/app.js --watch",
    "db:local": "supabase start",
    "db:local:stop": "supabase stop",
    "test": "vitest run && npx playwright test --project=default",
    "validate:v2-preflight": "node scripts/validate-v2-conventions-preflight.mjs",
    "v2:queue": "node scripts/v2-migration-queue.mjs",
    "v2:human-queue": "node scripts/v2-human-queue-list.mjs",
    "test:unit": "vitest run",
    "test:browser": "npx playwright test --project=default",
    "test:subclasses": "SUBCLASS_PARALLEL=1 SUBCLASS_WORKERS=3 npx playwright test --project=subclass-videos",
    "test:subclass": "npx playwright test --project=subclass-videos",
    "agents": "node --env-file=.env scripts/orchestrate.js",
    "setup:dev-agent-labels": "node --env-file=.env scripts/setup-dev-agent-labels.mjs",
    "setup:v2-migration-labels": "node --env-file=.env scripts/setup-v2-migration-labels.mjs",
    "v2:sync-tracker-md": "node --env-file=.env scripts/v2-sync-tracker-snapshot.mjs",
    "seed:v2-browser-chars": "node --env-file=.env scripts/seed-v2-browser-test-characters.mjs",
    "chunk:srd": "node scripts/chunk-srd-readme.mjs",
    "migrate:map-images": "node --env-file=.env scripts/migrate-map-images-to-storage.mjs",
    "migrate:item-images": "node --env-file=.env scripts/migrate-item-images-to-storage.mjs"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-virtual": "^3.13.0",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "firebase-admin": "^13.7.0",
    "fireworks-js": "^2.10.8",
    "multer": "^2.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.19.0",
    "puppeteer": "^24.37.5",
    "sharp": "^0.34.5",
    "stripe": "^22.3.2",
    "tesseract.js": "^7.0.0",
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.2.1",
    "ajv": "^8.18.0",
    "esbuild": "^0.27.3",
    "jsdom": "^29.0.1",
    "lucide-react": "^1.6.0",
    "supabase": "^2.81.3",
    "tailwindcss": "^4.2.1",
    "vitest": "^4.0.18"
  }
}
