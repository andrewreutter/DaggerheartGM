# Database
# Production: use your Supabase connection string
DATABASE_URL=postgresql://user:password@localhost:5432/daggerheart_gm
# Local dev (after running: npx supabase start  OR  npm run db:local):
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Server
PORT=3456
APP_ID=daggerheart-gm-tool
ADMIN_EMAILS=admin@example.com
# Same comma-separated format; grants dev-agent footer on V2 feature source modal (not full admin UI)
# QA_EMAILS=qa@example.com

# Firebase (for Auth)
FIREBASE_PROJECT_ID=your-project-id
# Your Firebase Auth user id (optional for npm run seed:v2-browser-chars if DB has one primary table_state)
# DH_GM_UID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_APP_ID=your-app-id

# Image Generation (x.ai Grok Imagine — https://docs.x.ai/developers/model-capabilities/images/generation)
XAI_API_KEY=xai-...
# Optional overrides (defaults are fine for most deployments):
# XAI_API_BASE=https://api.x.ai/v1
# XAI_IMAGE_MODEL=grok-imagine-image
# XAI_IMAGE_ASPECT_RATIO=16:9
# XAI_IMAGE_RESOLUTION=2k

# Global AI kill switch (optional — overrides all AI flags regardless of API key presence)
# Set to 1 to disable ALL AI features (image gen, concept builders, Library Assistant, semantic search).
# When set, GET /api/config returns imageGenEnabled=false and conceptAiEnabled=false, and all AI
# API endpoints return 503 even if XAI_API_KEY or OPENAI_API_KEY are set.
# AI_FEATURES_DISABLED=1

# OpenAI (Optional)
# OPENAI_API_KEY — enables:
#   - Library editors → "Build with AI" for characters, adversaries, environments
#     (POST /api/character-ai-build, /api/adversary-ai-build, /api/environment-ai-build); GET /api/config sets conceptAiEnabled
#   - Optional LLM fallback when Reddit/import stat blocks can't be parsed by regex + OCR (llm-parse)
OPENAI_API_KEY=sk-...
# Chat model override for character AI specifically. Falls back to OPENAI_CONCEPT_MODEL. Default: gpt-4o-mini
OPENAI_CHARACTER_MODEL=gpt-4o-mini
# Chat model for the other concept AI builders (and character AI fallback). Default: gpt-4o-mini
OPENAI_CONCEPT_MODEL=gpt-4o-mini
# CHARACTER_AI_DEBUG=1  # extra per-turn logging for the legality-first character builder
# AI_USAGE_DEBUG=1  # extra console logging from src/ai-usage-log.js (events also persist to ai_usage_events when DATABASE_URL is set)
# Optional: merge JSON overrides into OpenAI Standard pricing for GET /api/admin/ai-usage cost estimates (model id -> { inputPerM, cachedInputPerM|null, outputPerM })
# AI_USAGE_OPENAI_PRICING_JSON={"custom-model":{"inputPerM":1,"cachedInputPerM":0.5,"outputPerM":2}}

# Supabase Storage (optional — map images fall back to data URLs if unset)
# Production: set to your Supabase project URL and service role key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Local dev (values printed by: npx supabase start):
# SUPABASE_URL=http://localhost:54321
# SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase start output>

# Stripe (optional — Campaign Pass checkout; routes return 503 when unset)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_CAMPAIGN_PASS_3MO=price_...   # 3-month Campaign Pass ($20)
# STRIPE_PRICE_CAMPAIGN_PASS_6MO=price_...   # 6-month Campaign Pass ($35)
# STRIPE_PRICE_CAMPAIGN_PASS_12MO=price_...  # 12-month Campaign Pass ($60)
# APP_BASE_URL=https://your-domain.com       # success/cancel redirect base (default: https://daggerheart-gm.fly.dev)

# Overnight Agent Orchestrator (V2 feature development)
# Create from: https://cursor.com/dashboard/cloud-agents
# Required only to run: npm run agents
CURSOR_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: USD per completed agent by model id (merged over script defaults for stock CLI models).
# Use your Cursor Cloud Agents dashboard to tune. Example:
# ORCHESTRATOR_MODEL_COST_USD_JSON={"claude-4.6-opus-high-thinking":0.42,"claude-4.6-opus-high-thinking-fast":0.15}
# Optional: log top-level keys of one GET /v0/agents/:id response to see if usage/cost fields exist
# ORCHESTRATOR_DEBUG_AGENT_PAYLOAD=1
# Optional: GitHub PAT (repo scope) so val/unblock agents can open PRs. Also accepts GH_TOKEN.
# Use KEY=value — no "export" prefix (Node --env-file does not treat export lines like a shell).
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# V2 migration tracker: GITHUB_TOKEN + GitHub origin (or GITHUB_REPOSITORY) — Issues (label v2-migration).
# npm run setup:v2-migration-labels (once) ; regenerate read-only summary: npm run v2:sync-tracker-md

# Dev agent queue (optional — Feature Source modal footer for admins; local Cursor CLI + GitHub Issues)
# DEV_AGENT_QUEUE_ENABLED=1
# GITHUB_REPOSITORY=owner/repo   # optional: only if git remote is missing (CI); local dev uses `git remote origin`
# DEV_AGENT_WORKER=0
# DEV_AGENT_MODEL=composer-2
# DEV_AGENT_BASE_BRANCH=main
# DEV_AGENT_POLL_MS=60000
# DEV_AGENT_STALE_LOCK_MS=900000   # delete stale .dev-agent-worker.lock after a crash (default 15 min)
